# mock  = QR de demostración. No se cobra nada.
# live  = server/codi.js llama a la API de tu proveedor CoDi.
PAYMENT_MODE=mock

# Precio que decide el servidor. El navegador no puede cambiarlo.
PRICE_MXN=49

# Dirección a la que el banco devuelve al cliente.
# En el celular, dentro de la misma red, usa la IP de esta computadora:
# PUBLIC_BASE_URL=http://192.168.1.20:5173
PUBLIC_BASE_URL=http://localhost:5173

# Solo en PAYMENT_MODE=live. Estas llaves se leen en el servidor, nunca en la página.
CODI_API_BASE_URL=
CODI_API_KEY=
CODI_COMMERCE_ID=
